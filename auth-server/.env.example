GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# 32 bytes, base64 encoded. Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_STATE_KEY=
# Exact public HTTPS origin of this authentication service, without a trailing path.
AUTH_ORIGIN=https://your-auth-service.vercel.app
